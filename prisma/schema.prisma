generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         UserRole  @default(TEAM)
  expertId     String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  accounts     Account[]
  sessions     Session[]
  expert       Expert?   @relation(fields: [expertId], references: [id])

  @@index([deletedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Expert {
  id        String            @id @default(cuid())
  name      String
  email     String            @unique
  tags      String[]
  bio       String?
  deletedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  sessions  AnalysisSession[]
  user      User?
}

model Course {
  id           String    @id @default(cuid())
  name         String
  description  String?
  sheetUrl     String?   // Google Sheet URL for curriculum sync
  sheetTabName String?   // Sheet tab name (defaults to Sheet1)
  lastSyncedAt DateTime? // When the sheet was last synced
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  batches      Batch[]
  modules      Module[]
}

model Module {
  id                String             @id @default(cuid())
  name              String
  order             Int                @default(0)
  courseId          String
  sheetModuleId     String?            // Module ID from the Google Sheet (e.g. MM109)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  course            Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessions          SessionNote[]
  evaluationConfigs EvaluationConfig[]

  @@index([deletedAt])
  @@index([courseId])
  @@index([sheetModuleId])
}

model SessionNote {
  id                 String            @id @default(cuid())
  name               String
  content            String?           // "Notes <> What should be taught" — used by AI analysis
  phase              String?           // Week label (e.g. "Week 3")
  prerequisites      String?           // "Points To Note" — admin notes
  keyTopics          String[]
  expertGaps         String?           // Legacy field
  moduleId           String
  // --- Sheet Sync Fields ---
  sessionId          String?   @unique // Sheet's Session ID (e.g. S101) — upsert key
  weekOrder          Int?              // Numeric week order for sorting
  sessionType        String?           // e.g. "Live Session", "Workshop"
  expertType         String?           // e.g. "SST", "Copilot"
  duration           Int?              // Duration in minutes
  evaluationRequired Boolean           @default(false)
  linkContent        String?           // Slide deck / content link
  linkCharter        String?           // In-session charter link
  linkModelSolution  String?           // Model solution link
  linkTest           String?           // MCQ test link
  linkEvalParams     String?           // Evaluation parameters link
  expertBrief        String?           // "Brief to Experts from Acad Team"
  syncedAt           DateTime?         // When this record was last synced from sheet
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  analysisSessions   AnalysisSession[]
  module             Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([moduleId])
  @@index([sessionId])
}

model AnalysisSession {
  id                         String                  @id @default(cuid())
  name                       String
  expertId                   String
  sessionNoteId              String?
  conductedAt                DateTime?               // Date and Time when session was conducted live
  transcriptPath             String?
  transcriptRaw              String?
  transcript_clean           String?
  scheduledDuration          Int?
  v3Status                   PipelineStatus          @default(PENDING)
  v3Progress                 String?
  v3Error                    String?
  heartbeat                  DateTime?
  batchId                    String?
  deletedAt                  DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  pipeline_stage             String                  @default("UPLOADED")
  next_action_at             DateTime                @default(now())
  stage_attempts             Json                    @default("{}")
  chapters_json              Json?
  transcript_quality         String?                 @default("Good")
  transcript_quality_signals Json?                   @default("[]")
  schema_version             String?                 @default("v1")
  zoom_recording_id          String?
  zoom_download_url          String?
  videoUrl                   String?
  transcriptUrl              String?
  source                     String?                 @default("manual")
  tier                       String                  @default("TIER1")
  tier1Result                Json?
  oogwayGoResult             Json?
  oogwayGoStatus             String?                 @default("NOT_STARTED")
  studentGoResult            Json?
  studentGoStatus            String?                 @default("NOT_STARTED")
  // ─── Evaluation fields ────────────────────────────────────────────────────
  analysisType               String                  @default("LIVE_SESSION")  // "LIVE_SESSION" | "EVALUATION"
  evaluationTypeId           String?                 // FK → EvaluationConfig
  evaluationStudentName      String?                 // Name used to look up student in sheet
  evaluationResult           Json?                   // AI per-student verdict output
  AnalysisChapterResult      AnalysisChapterResult[]
  batch                      Batch?                  @relation(fields: [batchId], references: [id])
  expert                     Expert                  @relation(fields: [expertId], references: [id])
  sessionNote                SessionNote?            @relation(fields: [sessionNoteId], references: [id])
  evaluationConfig           EvaluationConfig?       @relation(fields: [evaluationTypeId], references: [id])
  v2Analysis                 AnalysisV2?

  @@index([deletedAt])
  @@index([expertId])
  @@index([next_action_at])
  @@index([pipeline_stage])
  @@index([analysisType])
}

model AnalysisV2 {
  id                    String          @id @default(cuid())
  sessionId             String          @unique
  status                String          @default("pending")
  progress              String?
  sessionFlow           Json?
  pillar6A              Json?
  pillar6B              Json?
  pillar6C              Json?
  epochSummaries        Json?
  verifierResult        Json?
  costEstimate          Float?
  error                 String?
  session_flags         Json?
  accuracy_issues       Json?
  teaching_depth_map    Json?
  pacing_map            Json?
  engagement_by_chapter Json?
  confusion_summary     Json?
  unresolved_doubts     Json?
  topics_missed         Json?
  context_setup         Json?
  topics_covered        Json?
  full_synthesis        Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  schema_version        String?         @default("v1")
  session               AnalysisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ─── Evaluation Configuration (per module, per evaluation type) ──────────────
model EvaluationConfig {
  id               String            @id @default(cuid())
  moduleId         String
  evaluationType   String            // "VIVA" | "INTERVIEW" (extensible)
  name             String            // Display name e.g. "Programmatic Viva"
  description      String?
  sheetUrl         String?           // Google Sheets CSV export URL (persistent, updated in place)
  scoreScale       Int               @default(4)  // Max score per criterion (e.g. 4 → scores 1-4)
  rubric           Json              @default("[]") // Array of RubricCriterion objects
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  module           Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  analysisSessions AnalysisSession[]

  @@index([moduleId])
  @@index([deletedAt])
}

model Batch {
  id          String            @id @default(cuid())
  name        String
  description String?
  courseId    String?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  sessions    AnalysisSession[]
  course      Course?           @relation(fields: [courseId], references: [id])
}

model AnalysisChapterResult {
  id              String          @id
  session_id      String
  chapter_index   Int
  result          Json
  needs_review    Boolean         @default(false)
  review_reasons  Json?           @default("[]")
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  AnalysisSession AnalysisSession @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([session_id, chapter_index])
  @@index([session_id], map: "idx_chapter_result_session")
}

enum UserRole {
  ADMIN
  TEAM
  EXPERT
}

enum PipelineStatus {
  PENDING
  PREPROCESSING
  EXTRACTING
  AGGREGATING
  SYNTHESISING
  COMPLETE
  FAILED
}
